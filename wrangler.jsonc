{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matisse",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "matisse-crm", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "ENVIRONMENT": "development", "WHATSAPP_NUMBER": "", "CONTACT_ENABLED": "false" },
  "observability": { "enabled": false }
}
