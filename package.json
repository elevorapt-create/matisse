{
  "name": "matisse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "XDG_CONFIG_HOME=/tmp/matisse-config WRANGLER_SEND_METRICS=false wrangler dev --ip 0.0.0.0",
    "db:local": "XDG_CONFIG_HOME=/tmp/matisse-config WRANGLER_SEND_METRICS=false wrangler d1 migrations apply matisse-crm --local",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/worker.js && node --check public/app.js && node --check public/admin.js",
    "build": "XDG_CONFIG_HOME=/tmp/matisse-config WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "admin:setup": "node scripts/admin-setup.mjs",
    "test:browser": "playwright test",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "wrangler": "4.160.0"
  }
}
